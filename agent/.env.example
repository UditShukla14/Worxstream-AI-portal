# Required: Anthropic
ANTHROPIC_API_KEY=
# Main model — agent / governance tool loops
ANTHROPIC_MODEL=claude-sonnet-4-6
# Fast model — execution plan, router, nova plan, self-check, summary, formatter
ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# Required: Worxstream API (or set via POST /api/auth/session after login)
WORXSTREAM_BASE_URL=
WORXSTREAM_API_TOKEN=
DEFAULT_COMPANY_ID=
DEFAULT_USER_ID=

# Scribe scheduled runs (criteria reports + Nova flow recipes) use WORXSTREAM_API_TOKEN.
# Free-form schedule emails use MCP send_email → POST /api/public/company/email/{code}/send
# (same path as Worxstream public company mail — no object_id).
WORXSTREAM_PUBLIC_EMAIL_CODE=
# Fallback codes if WORXSTREAM_PUBLIC_EMAIL_CODE unset: PUBLIC_EMAIL_CODE, PUBLIC_LIVEKIT_CODE
# Document/PDF emails use send_object_email → POST /master-objects/email/send (requires object_id).

# Required: Server
PORT=3000
NODE_ENV=development

# Required: Database
MONGODB_URL=

# Optional: Redis / Valkey (conversation context + estimates tool cache). Omit all to disable.
# Option A — single URL (use rediss:// for TLS, e.g. DigitalOcean managed Valkey on port 25061):
# REDIS_URL=rediss://default:YOUR_PASSWORD@your-host.digitalocean.com:25061
# Option B — discrete fields (password URL-encoded automatically; TLS auto for port 25061):
# REDIS_HOST=
# REDIS_PORT=25061
# REDIS_USERNAME=default
# REDIS_PASSWORD=
# REDIS_TLS=true
# REDIS_DB=
# REDIS_CONTEXT_TTL_SECONDS=1800
# REDIS_CACHE_TTL_SECONDS=60
# REDIS_TLS_REJECT_UNAUTHORIZED=false

# Required in production: public URL of this API and allowed CORS origins
BACKEND_URL=
CORS_ORIGINS=

# Optional: use PUBLIC_URL instead of BACKEND_URL
# PUBLIC_URL=

# Optional: context window limits
# MAX_CONTEXT_MESSAGES=0   # optional message-count cap (0 = off; the window is token-based)
# (working window: see CONTEXT_WINDOW_TOKENS below)
RESERVE_TOKENS=10000

# Optional: force tool search on/off (auto-detected by model if unset)
# ANTHROPIC_USE_TOOL_SEARCH=true

# Optimisation knobs
# AGENT_TOOL_RESULT_MAX_CHARS=30000   # cap on one tool result sent back to the model
# LOG_TOOL_INPUTS=false               # log full tool inputs (may contain PII)
# LOG_API_ERROR_BODIES=false          # log Worxstream API error bodies

# Context budgeting (limits come from the Models API; this is a COST cap, not the model limit)
# CONTEXT_WINDOW_TOKENS=200000   # working window per chat: min(model window, this). 200k = Claude's standard; 1000000 uses a 1M model fully (more cost per turn)
# CONTEXT_SAFETY_MARGIN=0.05
# CONTEXT_SOFT_RATIO=0.8    # auto-compact: fold older turns into the summary
# CONTEXT_HARD_RATIO=0.92   # clear old tool results inside the agent loop

# Billing
# NOVA_MARKUP_RATE=0.2          # Worxstream's margin on Anthropic's price (0.2 = +20%, the default), charged as a company's credit is spent. Nova plans are sold at a plain price; companies never see Anthropic's cost. Wallet `markup_rate` overrides per company.
# Stripe: Nova credit purchases are created and credited by the agent (src/billing/stripe/).
# STRIPE_SECRET_KEY=sk_test_...       # must be the same Stripe account as the web app's VITE_STRIPE_PUBLISHABLE_KEY
# STRIPE_WEBHOOK_SECRET=whsec_...     # webhook endpoint: https://<agent-host>/api/webhooks/stripe, events payment_intent.succeeded, charge.dispute.created, charge.dispute.closed
# Invoice seller details (printed on downloadable invoices; address lines separated with "|").
# INVOICE_SELLER_NAME=Worxstream
# INVOICE_SELLER_ADDRESS=Street 1|City, Country
# INVOICE_SELLER_TAX_ID=
# NOVA_MAX_TURN_COST_USD=3       # hard stop for one turn's provider cost (0 = off)

# Admin dashboard (served at /admin after `npm run admin:build`; sign in with ADMIN_API_KEY)
# ANTHROPIC_ADMIN_API_KEY=sk-ant-admin...      # enables Reconcile vs Anthropic's Usage & Cost API
# ANTHROPIC_RECONCILE_WORKSPACE_ID=wrkspc_...  # restrict reconciliation to this agent's workspace


# Extended thinking in chat (shown in the UI as a collapsible "Thinking" block). Supported models only; adaptive.
# NOVA_THINKING=adaptive   # or "off"

# Mail backend (read-only mailbox tools: search_mail, get_unread_mail_summary, ...). Leave empty to disable.
# The user's own Worxstream token is forwarded; the mail backend verifies it with Worxstream.
MAIL_AGENT_API_URL=

# Nova wallet (see docs/wallet.md)
# Free trial credit created the first time a company uses Nova (0 = off: a company with no wallet is unlimited).
NOVA_TRIAL_ALLOWANCE_USD=0
# true = a company with no wallet cannot use Nova until it buys or is granted credits.
NOVA_REQUIRE_WALLET=false
# "Low balance" warning: below this share of everything granted, or below this many dollars.
NOVA_LOW_BALANCE_RATIO=0.1
NOVA_LOW_BALANCE_USD=2
